    {
        if (world.getDimensionType().isUltrawarm())
        {
            world.removeBlock(pos, false);
        }
        else
        {
            world.setBlockState(pos, Blocks.WATER.getDefaultState());
            world.neighborChanged(pos, Blocks.WATER, pos);
