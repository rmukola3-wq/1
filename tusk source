            TextComponent timestamp = new StringTextComponent(" @ " + new Date(waypoint.getCreationTimestamp()));
            timestamp.setStyle(timestamp.getStyle().setFormatting(TextFormatting.DARK_GRAY));
            component.append(tagComponent);
