    private void rescan(List<BlockPos> already, CalculationContext context) {
        // РџСЂРѕРІРµСЂРєР° РЅР° Р·Р°РіСЂСѓР·РєСѓ РјРёСЂР° - РёР·Р±РµРіР°РµРј С„СЂРёР·РѕРІ РїСЂРё Р·Р°РіСЂСѓР·РєРµ
        if (ctx.world() == null || ctx.world().getChunkProvider() == null) {
