            return blockstate.with(LAYERS, Integer.valueOf(Math.min(8, i + 1)));
        }
        else
        {
            return super.getStateForPlacement(context);
        }
    }

    protected void fillStateContainer(StateContainer.Builder<Block, BlockState> builder)
