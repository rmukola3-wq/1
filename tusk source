            framebufferRead = framebufferIn;
            framebufferDraw = framebufferIn;
        } else if (target == 36008) {
            if (framebufferRead == framebufferIn) {
                return;
            }

            framebufferRead = framebufferIn;
        }

        if (target == 36009) {
            if (framebufferDraw == framebufferIn) {
                return;
