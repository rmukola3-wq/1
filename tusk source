        if (filter != null) {
            // РџСЂРѕРІРµСЂРєР° РЅР° Р·Р°РіСЂСѓР·РєСѓ РјРёСЂР° РїРµСЂРµРґ Р·Р°РїСѓСЃРєРѕРј СЃРєР°РЅРёСЂРѕРІР°РЅРёСЏ
            if (ctx.world() != null && ctx.world().getChunkProvider() != null) {
                // Р—Р°РїСѓСЃРєР°РµРј rescan Р°СЃРёРЅС…СЂРѕРЅРЅРѕ РґР»СЏ РёР·Р±РµР¶Р°РЅРёСЏ С„СЂРёР·РѕРІ
                Baritone.getExecutor().execute(() -> {
                    try {
                        rescan(new ArrayList<>(), new CalculationContext(baritone));
                    } catch (Exception e) {
                        // РРіРЅРѕСЂРёСЂСѓРµРј РѕС€РёР±РєРё РїСЂРё Р·Р°РіСЂСѓР·РєРµ РјРёСЂР°
                    }
                });
            }
        }
    }

    private BlockOptionalMetaLookup filterFilter() {
        if (this.filter == null) {
            return null;
        }
        if (!Baritone.settings().allowBreak.value) {
            BlockOptionalMetaLookup f = new BlockOptionalMetaLookup(this.filter.blocks()
                    .stream()
                    .filter(e -> Baritone.settings().allowBreakAnyway.value.contains(e.getBlock()))
                    .toArray(BlockOptionalMeta[]::new));
            if (f.blocks().isEmpty()) {
                logDirect("Unable to mine when allowBreak is false and target block is not in allowBreakAnyway!");
                return null;
            }
            return f;
        }
        return filter;
    }
