        if (server != null) {
            server.onPlayerLoggedIn(serverPlayer);
        }
        if (!Voicechat.SERVER_CONFIG.forceVoiceChat.get()) {
            return;
        }

        Timer timer = new Timer(serverPlayer.getGameProfile().getName() + "%s-login-timer", true);
        timer.schedule(new TimerTask() {
            @Override
