        if (vector3d.y < 0.0D)
        {
            double d0 = entity instanceof LivingEntity ? (Manager.FUNCTION_MANAGER.noBounce.state && Manager.FUNCTION_MANAGER.noBounce.blocks.get(0) ? 0.0D : 1.0D) : 0.8D;
