        selectedMorzhCategory = null;
        morzhModuleList.clear();

        morzhModuleList
            .add(theme.horizontalSeparator("All Modules"))
            .expandX();

        List<Module> modules = new ArrayList<>();

        for (Module module : Modules.get().getAll()) {
            if (!Config.get().hiddenModules.get().contains(module)) {
                modules.add(module);
            }
        }

        modules.sort(
            (a, b) -> String.CASE_INSENSITIVE_ORDER.compare(
                a.name,
                b.name
            )
        );

        for (Module module : modules) {
            morzhModuleList
                .add(theme.module(module))
                .expandX();
