            .add(theme.horizontalSeparator(category.name))
            .expandX();

        int count = 0;

        for (Module module : Modules.get().getGroup(category)) {
            if (Config.get().hiddenModules.get().contains(module)) {
                continue;
            }

            morzhModuleList
                .add(theme.module(module))
                .expandX();

            count++;
        }

        if (count == 0) {
            morzhModuleList.add(
                theme.label("No visible modules in this category.")
            );
        }
    }

