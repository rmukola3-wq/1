    private void showMorzhSearch(String text) {
        morzhModuleList.clear();

        String query = text.toLowerCase(Locale.ROOT);

        morzhModuleList.add(theme.horizontalSeparator(
            "Search: " + text
        )).expandX();

        List<Module> found = new ArrayList<>();

        for (Module module : Modules.get().getAll()) {
            if (Config.get().hiddenModules.get().contains(module)) continue;

            boolean matchesName =
                module.name.toLowerCase(Locale.ROOT).contains(query);

            boolean matchesTitle =
                module.title.toLowerCase(Locale.ROOT).contains(query);

            boolean matchesDescription =
                module.description != null
                    && module.description.toLowerCase(Locale.ROOT)
                    .contains(query);

            boolean matchesSetting = false;

            for (SettingGroupView group : getSettingGroups(module)) {
                for (String settingName : group.names) {
                    if (settingName.toLowerCase(Locale.ROOT).contains(query)) {
                        matchesSetting = true;
                        break;
                    }
                }

                if (matchesSetting) break;
            }

            if (matchesName
                || matchesTitle
                || matchesDescription
                || matchesSetting) {
                found.add(module);
            }
        }

        found.sort((a, b) ->
            String.CASE_INSENSITIVE_ORDER.compare(a.name, b.name)
        );

        int limit = Config.get().moduleSearchCount.get();
        int displayed = 0;

        for (Module module : found) {
            if (displayed >= limit) break;

            morzhModuleList.add(theme.module(module)).expandX();
            displayed++;
        }

        if (found.isEmpty()) {
            morzhModuleList.add(theme.label("Nothing found."));
        } else if (found.size() > displayed) {
            morzhModuleList.add(theme.label(
                "Showing " + displayed + " of " + found.size()
            ));
        }
    }

    private List<SettingGroupView> getSettingGroups(Module module) {
        List<SettingGroupView> result = new ArrayList<>();

        module.settings.forEach(group -> {
            SettingGroupView view = new SettingGroupView();

            for (Setting<?> setting : group) {
                view.names.add(setting.name);
            }

            result.add(view);
        });

        return result;
    }

