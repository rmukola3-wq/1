$utf8 = New-Object System.Text.UTF8Encoding($false)

# Исправить пути звуков.
$json = [System.IO.File]::ReadAllText((Resolve-Path $sounds))
$json = $json.Replace(
    "morzh-client:sounds/gui/",
    "morzh-client:gui/"
)
$json = $json.Replace(
    "morzh-client:sounds/combat/",
    "morzh-client:combat/"
)

[System.IO.File]::WriteAllText(
    (Resolve-Path $sounds),
    $json,
    $utf8
)

# Полностью убрать blur, атмосферный слой и матричные преобразования.
$code = [System.IO.File]::ReadAllText((Resolve-Path $screen))

$code = [regex]::Replace(
    $code,
    '(?m)^\s*renderBackground\(context, mouseX, mouseY, delta\);\s*$',
    ''
)

$code = [regex]::Replace(
    $code,
    '(?m)^\s*renderAtmosphere\(context\);\s*$',
    '        context.fill(0, 0, width, height, 0xB0000000);'
)

$code = [regex]::Replace(
    $code,
    '(?m)^\s*context\.getMatrices\(\)\.(push|pop|translate|scale)\(.*?\);\s*$',
    ''
)

# Сделать основные панели полностью непрозрачными.
$code = $code.Replace(
    "private static final int BACKGROUND = 0xF218141E;",
    "private static final int BACKGROUND = 0xFF18141E;"
)

$code = $code.Replace(
    "private static final int PANEL = 0xF2211B29;",
    "private static final int PANEL = 0xFF211B29;"
)

$code = $code.Replace(
    "private static final int CONTENT = 0xF2251D2D;",
    "private static final int CONTENT = 0xFF251D2D;"
)

[System.IO.File]::WriteAllText(
    (Resolve-Path $screen),
    $code,
    $utf8
)

