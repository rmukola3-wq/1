    protected boolean createFavoritesW(WWindow window) {
        List<Module> modules = new ArrayList<>();

        for (Module module : Modules.get().getAll()) {
            if (module.favorite) {
                modules.add(module);
            }
        }

        modules.sort((a, b) ->
            String.CASE_INSENSITIVE_ORDER.compare(a.name, b.name)
