    private boolean clickThunder(int mouseX, int mouseY, int button) {
        int contentY = panelY + 40;
        int categoryY = contentY + 23;

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            if (inside(
                mouseX,
                mouseY,
                panelX + 10,
                categoryY,
                82,
                16
            )) {
                selectedCategory = category;
                selectedModule = null;
                moduleScroll = 0;
                search = "";
                searching = false;

                playSound(0.95f);
                return true;
            }

            categoryY += 18;
        }

        int modulesX = panelX + 102;
        int listTop = contentY + 22;
        int listBottom = panelY + panelHeight - 12;

        float moduleY = listTop + moduleScroll;

        for (Module module : getDisplayedModules()) {
            if (moduleY + 29 >= listTop
                && moduleY <= listBottom
                && inside(
                    mouseX,
                    mouseY,
                    modulesX + 6,
                    moduleY,
                    133,
                    28
                )) {
                activateModule(module, button);
                return true;
            }

            moduleY += 32;
        }

        int infoX = panelX + 252;
        int infoWidth = panelWidth - 257;
        int contentHeight = panelHeight - 46;

        if (selectedModule != null
            && inside(
                mouseX,
                mouseY,
                infoX + 8,
                contentY + contentHeight - 30,
                infoWidth - 16,
                20
            )) {
            openSettings(selectedModule);
            return true;
        }

        searching = false;
        return false;
    }

    private boolean clickClassic(int mouseX, int mouseY, int button) {
        int areaX = panelX + 6;
        int areaY = panelY + 40;
        int areaHeight = panelHeight - 47;

        int columnWidth = 104;
        int columnX = areaX + 5 + (int) classicScroll;

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            int moduleY = areaY + 29;

            for (Module module : Modules.get().getGroup(category)) {
                if (Config.get().hiddenModules.get().contains(module)) continue;
                if (moduleY + 19 > areaY + areaHeight - 4) break;

