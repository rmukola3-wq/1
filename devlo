package meteordevelopment.meteorclient.utils.sound;

import net.minecraft.client.MinecraftClient;
import net.minecraft.client.sound.PositionedSoundInstance;
import net.minecraft.sound.SoundEvent;
import net.minecraft.util.Identifier;

public final class MorzhSoundManager {
    private static final String ID = "morzh-client";

    private static final SoundEvent OPEN = sound("gui.open");
    private static final SoundEvent CLOSE = sound("gui.close");
    private static final SoundEvent KEYPRESS = sound("gui.keypress");
    private static final SoundEvent SCROLL = sound("gui.scroll");
    private static final SoundEvent ENABLE = sound("module.enable");
    private static final SoundEvent DISABLE = sound("module.disable");

    private static long lastScroll;

    private MorzhSoundManager() {}

    private static SoundEvent sound(String path) {
        return SoundEvent.of(Identifier.of(ID, path));
    }

    private static void play(SoundEvent sound) {
        MinecraftClient client = MinecraftClient.getInstance();
        if (client == null) return;

        client.getSoundManager().play(
            PositionedSoundInstance.master(sound, 1.0f)
        );
    }

    public static void playOpen() {
        play(OPEN);
    }

    public static void playClose() {
        play(CLOSE);
    }

    public static void playKeyPress() {
        play(KEYPRESS);
    }

    public static void playScroll() {
        long now = System.currentTimeMillis();
        if (now - lastScroll < 50) return;

        lastScroll = now;
        play(SCROLL);
    }

    public static void playModuleState(boolean enabled) {
        play(enabled ? ENABLE : DISABLE);
    }
}
