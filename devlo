            SettingColor normalColor,
            SettingColor hoveredColor,
            SettingColor pressedColor
        ) {
            normal = color(
                group,
                name,
                "Color of " + name + ".",
                normalColor
            );

            hovered = color(
                group,
                "hovered-" + name,
                "Color of " + name + " when hovered.",
                hoveredColor
            );

            pressed = color(
                group,
                "pressed-" + name,
                "Color of " + name + " when pressed.",
                pressedColor
            );
        }

        public SettingColor get() {
            return normal.get();
        }

        public SettingColor get(
            boolean isPressed,
            boolean isHovered,
            boolean bypassDisableHoverColor
        ) {
            if (isPressed) return pressed.get();

            if (isHovered
                && (bypassDisableHoverColor || !disableHoverColor)) {
                return hovered.get();
            }

            return normal.get();
        }

        public SettingColor get(
            boolean isPressed,
            boolean isHovered
        ) {
            return get(isPressed, isHovered, false);
        }
    }
