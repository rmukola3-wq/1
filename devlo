    public void init() {
        List<Module> moduleList = new ArrayList<>();
        for (Category category : Modules.loopCategories()) {
            for (Module module : Modules.get().getGroup(category)) {
                if (!Config.get().hiddenModules.get().contains(module)) {
                    moduleList.add(module);
