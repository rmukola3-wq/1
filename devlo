    private void showMorzhSearch(String query) {
        if (morzhModuleList == null) return;

        selectedMorzhCategory = null;
        morzhModuleList.clear();

        morzhModuleList
            .add(theme.horizontalSeparator("Search: " + query))
            .expandX();

        Set<Module> results = new LinkedHashSet<>();

        results.addAll(Modules.get().searchTitles(query));
        results.addAll(Modules.get().searchSettingTitles(query));

        results.removeIf(
            module -> Config.get().hiddenModules.get().contains(module)
        );

        if (results.isEmpty()) {
            morzhModuleList.add(theme.label("Nothing found."));
            return;
        }

        int count = 0;
        int limit = Config.get().moduleSearchCount.get();

        for (Module module : results) {
            if (count >= limit) break;

            morzhModuleList
                .add(theme.module(module))
                .expandX();

            count++;
        }
    }

