    private final AuraAimPointResolver aimPointResolver =
        new AuraAimPointResolver();

    private final List<Entity> targets = new ArrayList<>();

    private Entity lockedTarget;
    private Vec3d currentAimPoint;

    private int switchTimer;
    private int hitTimer;
    private int shieldBreakCooldown;

    private boolean wasPathing;

    public boolean attacking;
    public boolean swapped;

    public static int previousSlot = -1;

    public KillAura() {
        super(
            Categories.Combat,
            "kill-aura",
            "Morzh Aura with hitbox point tracking and target locking."
        );
    }

    @Override
    public void onActivate() {
        targets.clear();
        lockedTarget = null;
        currentAimPoint = null;

        aimPointResolver.reset();

        previousSlot = -1;
        switchTimer = 0;
        hitTimer = 0;
        shieldBreakCooldown = 0;

        attacking = false;
        swapped = false;
        wasPathing = false;
    }

    @Override
    public void onDeactivate() {
        clearCombat();
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (shieldBreakCooldown > 0) shieldBreakCooldown--;

        if (mc.player == null || mc.world == null || mc.interactionManager == null) {
            clearCombat();
            return;
        }

        if (!mc.player.isAlive()
            || PlayerUtils.getGameMode() == GameMode.SPECTATOR) {
            clearCombat();
            return;
        }

        if (pauseOnUse.get()
            && (mc.interactionManager.isBreakingBlock()
            || mc.player.isUsingItem())) {
            stopAttacking();
            return;
        }

        if (onlyOnClick.get() && !mc.options.attackKey.isPressed()) {
            stopAttacking();
            return;
        }

        if (pauseOnLag.get()
            && TickRate.INSTANCE.getTimeSinceLastTick() >= 1.0f) {
            stopAttacking();
            return;
        }

        CrystalAura crystalAura = Modules.get().get(CrystalAura.class);

        if (pauseOnCA.get()
            && crystalAura != null
            && crystalAura.isActive()
            && crystalAura.kaTimer > 0) {
            stopAttacking();
            return;
        }

        updateTargets();

        if (targets.isEmpty()) {
            currentAimPoint = null;
            stopAttacking();
            return;
        }

        Entity primary = targets.getFirst();

        currentAimPoint = aimPointResolver.resolve(
            mc,
            primary,
            range.get(),
            wallsRange.get()
        );

        if (currentAimPoint == null) {
            if (lockedTarget == primary) lockedTarget = null;

            targets.clear();
            stopAttacking();
            return;
        }

        if (!prepareWeapon()) {
            stopAttacking();
            return;
        }

        if (!itemInHand()) {
            stopAttacking();
            return;
        }

        attacking = true;

        if (rotation.get() == RotationMode.Always) {
            rotate(currentAimPoint);
        }

        if (pauseBaritone.get()
            && PathManagers.get().isPathing()
            && !wasPathing) {
            PathManagers.get().pause();
            wasPathing = true;
        }

        if (!delayCheck()) return;

        for (Entity target : List.copyOf(targets)) {
            if (!entityCheck(target)) continue;
            attack(target);
        }
    }

    @EventHandler
    private void onSendPacket(PacketEvent.Send event) {
        if (event.packet instanceof UpdateSelectedSlotC2SPacket) {
            switchTimer = switchDelay.get();
        }
    }

    private void updateTargets() {
        targets.clear();

        if (onlyOnLook.get()) {
            lockedTarget = null;

            Entity targeted = mc.targetedEntity;

            if (targeted != null && entityCheck(targeted)) {
                targets.add(targeted);
            }

            return;
        }

        if (targetLock.get() && lockedTarget != null) {
            if (entityCheck(lockedTarget)) {
                targets.add(lockedTarget);
                return;
            }

            lockedTarget = null;
            aimPointResolver.reset();
        }

        int amount = targetLock.get() ? 1 : maxTargets.get();

        TargetUtils.getList(
            targets,
            this::entityCheck,
            priority.get(),
            amount
        );

        if (targetLock.get() && !targets.isEmpty()) {
            lockedTarget = targets.getFirst();
        }
    }

    private boolean prepareWeapon() {
        if (!autoSwitch.get()) return true;

        FindItemResult result = findWeapon();

        if (!result.found() || result.slot() < 0) return false;

        int selectedSlot = mc.player.getInventory().selectedSlot;

        if (!swapped && result.slot() != selectedSlot) {
            previousSlot = selectedSlot;
            swapped = true;
        }

        if (result.slot() != selectedSlot) {
            InvUtils.swap(result.slot(), false);
        }

        return true;
    }

    private FindItemResult findWeapon() {
        if (shouldShieldBreak()) {
            return InvUtils.findInHotbar(
                stack -> stack.getItem() instanceof AxeItem
            );
        }

        return switch (weapon.get()) {
            case Sword -> InvUtils.findInHotbar(
                stack -> stack.getItem() instanceof SwordItem
            );

            case Axe -> InvUtils.findInHotbar(
                stack -> stack.getItem() instanceof AxeItem
            );

            case Mace -> InvUtils.findInHotbar(
                stack -> stack.getItem() instanceof MaceItem
            );

            case Trident -> InvUtils.findInHotbar(
                stack -> stack.getItem() instanceof TridentItem
            );

            case All -> findPreferredWeapon();

            case Any -> InvUtils.findInHotbar(stack -> true);
        };
    }

    private FindItemResult findPreferredWeapon() {
        FindItemResult result = InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof SwordItem
        );

        if (result.found()) return result;

        result = InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof MaceItem
        );

        if (result.found()) return result;

        result = InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof TridentItem
        );

        if (result.found()) return result;

        return InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof AxeItem
        );
    }

    private void rotate(Vec3d point) {
        Vec3d eyes = mc.player.getEyePos();

        double deltaX = point.x - eyes.x;
        double deltaY = point.y - eyes.y;
        double deltaZ = point.z - eyes.z;

        double horizontal = Math.sqrt(
            deltaX * deltaX + deltaZ * deltaZ
        );

        float yaw = (float) (
            Math.toDegrees(Math.atan2(deltaZ, deltaX)) - 90.0
        );

        float pitch = (float) (
            -Math.toDegrees(Math.atan2(deltaY, horizontal))
        );

        Rotations.rotate(yaw, MathHelper.clamp(pitch, -90f, 90f));
    }

    private void attack(Entity target) {
        if (target == null || !target.isAlive() || !entityCheck(target)) {
            return;
        }

        Vec3d attackPoint = aimPointResolver.resolve(
            mc,
            target,
            range.get(),
            wallsRange.get()
        );

        if (attackPoint == null) return;

        if (rotation.get() == RotationMode.OnHit) {
            rotate(attackPoint);
        }

        boolean breakingShield =
            shouldShieldBreak()
                && mc.player.getMainHandStack().getItem()
                instanceof AxeItem;

        mc.interactionManager.attackEntity(mc.player, target);
        mc.player.swingHand(Hand.MAIN_HAND);

        if (breakingShield) {
            // Prevent Aura from remaining on the axe after one shield hit.
            shieldBreakCooldown = 10;
        }

        hitTimer = 0;
    }

    private void stopAttacking() {
        attacking = false;

        if (wasPathing) {
            PathManagers.get().resume();
            wasPathing = false;
        }

        if (swapped) {
            if (swapBack.get()
                && previousSlot >= 0
                && previousSlot <= 8) {
                InvUtils.swap(previousSlot, false);
            }

            swapped = false;
            previousSlot = -1;
        }
    }

    private void clearCombat() {
        targets.clear();

        lockedTarget = null;
        currentAimPoint = null;

        aimPointResolver.reset();
        stopAttacking();
    }

    private boolean shouldShieldBreak() {
        if (shieldMode.get() != ShieldMode.Break) return false;
        if (shieldBreakCooldown > 0) return false;

        for (Entity entity : targets) {
            if (entity instanceof PlayerEntity player
                && player.isBlocking()) {
                return true;
            }
        }

        return false;
    }

    private boolean entityCheck(Entity entity) {
        if (entity == null) return false;
        if (entity == mc.player || entity == mc.cameraEntity) return false;
        if (!entity.isAlive()) return false;

        if (entity instanceof LivingEntity living && living.isDead()) {
            return false;
        }

        Box box = entity.getBoundingBox();

        double closestX = MathHelper.clamp(
            mc.player.getX(),
            box.minX,
            box.maxX
        );

        double closestY = MathHelper.clamp(
            mc.player.getY(),
            box.minY,
            box.maxY
        );

        double closestZ = MathHelper.clamp(
            mc.player.getZ(),
            box.minZ,
            box.maxZ
        );

        if (!PlayerUtils.isWithin(
            closestX,
            closestY,
            closestZ,
            range.get()
        )) {
            return false;
        }

        if (!entities.get().contains(entity.getType())) return false;
        if (ignoreNamed.get() && entity.hasCustomName()) return false;

        if (!PlayerUtils.canSeeEntity(entity)
            && !PlayerUtils.isWithin(entity, wallsRange.get())) {
            return false;
        }

        if (ignoreTamed.get() && entity instanceof Tameable tameable) {
            if (tameable.getOwnerUuid() != null
                && tameable.getOwnerUuid().equals(mc.player.getUuid())) {
                return false;
            }
        }

        if (ignorePassive.get()) {
            if (entity instanceof EndermanEntity enderman
                && !enderman.isAngry()) {
                return false;
            }

            if (entity instanceof ZombifiedPiglinEntity piglin
                && !piglin.isAttacking()) {
                return false;
            }

            if (entity instanceof WolfEntity wolf
                && !wolf.isAttacking()) {
                return false;
            }
        }

        if (entity instanceof PlayerEntity player) {
            if (player.isCreative()) return false;
            if (!Friends.get().shouldAttack(player)) return false;

            if (shieldMode.get() == ShieldMode.Ignore
                && player.isBlocking()) {
                return false;
            }
        }

        if (entity instanceof AnimalEntity animal) {
            return switch (mobAgeFilter.get()) {
                case Baby -> animal.isBaby();
                case Adult -> !animal.isBaby();
                case Both -> true;
            };
        }

        return true;
    }

    private boolean delayCheck() {
        if (switchTimer > 0) {
            switchTimer--;
            return false;
        }

        if (!customDelay.get()) {
            float tickDelta = 0.5f;

            if (tpsSync.get()) {
                float factor =
                    TickRate.INSTANCE.getTickRate() / 20.0f;

                if (factor > 0) tickDelta /= factor;
            }

            return mc.player.getAttackCooldownProgress(tickDelta) >= 1.0f;
        }

        float requiredTicks = hitDelay.get();

        if (tpsSync.get()) {
            float factor =
                TickRate.INSTANCE.getTickRate() / 20.0f;

            if (factor > 0) requiredTicks /= factor;
        }

        if (hitTimer < requiredTicks) {
            hitTimer++;
            return false;
        }

        return true;
    }

    private boolean itemInHand() {
        Item item = mc.player.getMainHandStack().getItem();

        if (shouldShieldBreak()) {
            return item instanceof AxeItem;
        }

        return switch (weapon.get()) {
            case Sword -> item instanceof SwordItem;
            case Axe -> item instanceof AxeItem;
            case Mace -> item instanceof MaceItem;
            case Trident -> item instanceof TridentItem;

            case All ->
                item instanceof SwordItem
                    || item instanceof AxeItem
                    || item instanceof MaceItem
                    || item instanceof TridentItem;

            case Any -> true;
        };
    }

    public Entity getTarget() {
        return targets.isEmpty() ? null : targets.getFirst();
    }

    public Vec3d getCurrentAimPoint() {
        return currentAimPoint;
    }

    @Override
    public String getInfoString() {
        Entity target = getTarget();
        return target == null ? null : EntityUtils.getName(target);
    }

    public enum Weapon {
        Sword,
        Axe,
        Mace,
        Trident,
        All,
        Any
    }

    public enum RotationMode {
        Always,
        OnHit,
        None
    }

    public enum ShieldMode {
        Ignore,
        Break,
        None
    }

    public enum EntityAge {
        Baby,
        Adult,
        Both
    }
}


