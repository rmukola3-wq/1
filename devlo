    // Standard Meteor favorites

    protected Cell<WWindow> createFavorites(WContainer container) {
        boolean hasFavorites = Modules.get().getAll().stream()
            .anyMatch(module -> module.favorite);

        if (!hasFavorites) return null;

        WWindow window = theme.window("Favorites");
        window.id = "favorites";
