/*
 * Morzh Client
 *
 * Original implementation inspired by visible-point tracking concepts
 * used in modern combat clients.
 */

package meteordevelopment.meteorclient.systems.modules.combat.aura;

import net.minecraft.client.MinecraftClient;
import net.minecraft.entity.Entity;
import net.minecraft.util.hit.HitResult;
import net.minecraft.util.math.Box;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;
import net.minecraft.world.RaycastContext;

public final class AuraAimPointResolver {
    private int previousTargetId = -1;
    private Vec3d previousPoint;

    /**
     * Returns an attackable point inside the entity hitbox.
     * Visible points are preferred. The previous valid point is retained
     * to prevent unnecessary rotation jumps.
     */
    public Vec3d resolve(
        MinecraftClient mc,
        Entity target,
        double attackRange,
        double wallsRange
    ) {
        if (mc.player == null || mc.world == null || target == null) {
            reset();
            return null;
        }

        Box box = target.getBoundingBox();
        Vec3d eyes = mc.player.getEyePos();

        if (target.getId() == previousTargetId
            && previousPoint != null
            && box.expand(0.01).contains(previousPoint)
            && inRange(eyes, previousPoint, attackRange)
            && isVisible(mc, eyes, previousPoint)) {
            return previousPoint;
        }

        Vec3d center = box.getCenter();
        double height = box.getLengthY();

        Vec3d closest = new Vec3d(
            MathHelper.clamp(eyes.x, box.minX, box.maxX),
            MathHelper.clamp(eyes.y, box.minY + 0.05, box.maxY - 0.05),
            MathHelper.clamp(eyes.z, box.minZ, box.maxZ)
        );

        Vec3d[] candidates = {
            closest,
            center,
            new Vec3d(center.x, box.minY + height * 0.72, center.z),
            new Vec3d(center.x, box.minY + height * 0.55, center.z),
            new Vec3d(center.x, box.minY + height * 0.35, center.z),

            new Vec3d(box.minX + 0.02, box.minY + height * 0.65, center.z),
            new Vec3d(box.maxX - 0.02, box.minY + height * 0.65, center.z),
            new Vec3d(center.x, box.minY + height * 0.65, box.minZ + 0.02),
            new Vec3d(center.x, box.minY + height * 0.65, box.maxZ - 0.02)
        };

        Vec3d bestVisible = null;
        double bestVisibleDistance = Double.MAX_VALUE;

        for (Vec3d point : candidates) {
            double distance = eyes.squaredDistanceTo(point);

            if (distance > attackRange * attackRange) continue;
            if (!isVisible(mc, eyes, point)) continue;

            if (distance < bestVisibleDistance) {
                bestVisibleDistance = distance;
                bestVisible = point;
            }
        }

        if (bestVisible != null) {
            save(target, bestVisible);
            return bestVisible;
        }

        // No visible point: allow the closest hitbox point only inside wall range.
        if (inRange(eyes, closest, wallsRange)) {
            save(target, closest);
            return closest;
        }

        clearPoint();
        return null;
    }

    public boolean isVisible(
        MinecraftClient mc,
        Vec3d start,
        Vec3d end
    ) {
        if (mc.player == null || mc.world == null) return false;

        HitResult result = mc.world.raycast(
            new RaycastContext(
                start,
                end,
                RaycastContext.ShapeType.COLLIDER,
                RaycastContext.FluidHandling.NONE,
                mc.player
            )
        );

        if (result.getType() == HitResult.Type.MISS) return true;

        double pointDistance = start.squaredDistanceTo(end);
        double blockDistance = start.squaredDistanceTo(result.getPos());

        return blockDistance + 0.0001 >= pointDistance;
    }

    public boolean inRange(Vec3d start, Vec3d point, double range) {
        return range > 0 && start.squaredDistanceTo(point) <= range * range;
    }

    public Vec3d getPreviousPoint() {
        return previousPoint;
    }

    public void reset() {
        previousTargetId = -1;
        previousPoint = null;
    }

    private void save(Entity target, Vec3d point) {
        previousTargetId = target.getId();
        previousPoint = point;
    }

    private void clearPoint() {
        previousPoint = null;
    }
}


