    private void renderClassicCategory(
        DrawContext context,
        Category category,
        int x,
        int y,
        int width,
        int maxHeight,
        int mouseX,
        int mouseY
    ) {
        roundedRect(
            context,
            x,
            y,
            width,
            maxHeight,
            5,
            PANEL
        );

        roundedRect(
            context,
            x,
            y,
            width,
            20,
            5,
            ACCENT_DARK
        );

        context.drawText(
            textRenderer,
            shorten(category.name, 14),
            x + 7,
            y + 7,
            TEXT,
            true
        );

        int moduleY = y + 24;

        for (Module module : Modules.get().getGroup(category)) {
            if (Config.get().hiddenModules.get().contains(module)) continue;
            if (moduleY + 19 > y + maxHeight - 4) break;

            boolean hovered = inside(
                mouseX,
                mouseY,
                x + 4,
                moduleY,
                width - 8,
                18
            );

            if (hovered) hoveredModule = module;

            renderModuleCard(
                context,
                module,
                hovered,
                module == selectedModule,
                x + 4,
                moduleY,
                width - 8,
                18
            );

            moduleY += 20;
        }
    }

    private void renderModuleCard(
        DrawContext context,
        Module module,
        boolean hovered,
        boolean selected,
        int x,
        int y,
        int width,
        int height
    ) {
        float hover = hoverAnimations.getOrDefault(module, 0f);
        float hoverTarget = hovered ? 1f : 0f;

        hover += (hoverTarget - hover) * 0.24f;
        hoverAnimations.put(module, hover);

        float active = toggleAnimations.getOrDefault(
            module,
            module.isActive() ? 1f : 0f
        );

        float activeTarget = module.isActive() ? 1f : 0f;

        active += (activeTarget - active) * 0.2f;
        toggleAnimations.put(module, active);

        roundedRect(
            context,
            x,
            y,
            width,
            height,
            4,
            blend(CARD, CARD_HOVER, hover)
        );

        if (selected) {
            context.fill(
                x,
                y + 3,
                x + 2,
                y + height - 3,
                ACCENT
            );
        }

        if (active > 0.01f) {
            context.fill(
                x,
                y + height - 2,
                x + (int) (width * active),
                y + height,
                ACCENT
            );
        }

        context.drawText(
            textRenderer,
            shorten(module.title, height <= 18 ? 13 : 18),
            x + 6,
            y + (height <= 18 ? 5 : 6),
            module.isActive() ? TEXT : TEXT_SECONDARY,
            false
        );

        if (height > 20) {
            context.drawText(
                textRenderer,
                module.isActive() ? "ON" : "OFF",
                x + width - 24,
                y + 16,
                module.isActive() ? GREEN : RED,
                false
            );
        }
    }

    @Override
    public boolean mouseClicked(
        double mouseX,
        double mouseY,
        int button
    ) {
        int mx = (int) mouseX;
        int my = (int) mouseY;

        if (inside(mx, my, panelX + 95, panelY + 10, 48, 18)) {
            layout = Layout.Thunder;
            moduleScroll = 0;
            playSound(1.15f);
            return true;
        }

        if (inside(mx, my, panelX + 147, panelY + 10, 45, 18)) {
            layout = Layout.Classic;
            searching = false;
            playSound(1.05f);
            return true;
        }

        if (layout == Layout.Thunder) {
            int searchWidth = Math.min(137, panelWidth / 3);
            int searchX = panelX + panelWidth - searchWidth - 12;

            if (inside(
                mx,
                my,
                searchX,
                panelY + 11,
                searchWidth,
                17
            )) {
                searching = true;
                playSound(1.2f);
                return true;
            }
        }

        if (inside(
            mx,
            my,
            panelX + 5,
            panelY + 5,
            panelWidth - 10,
            30
        )) {
            dragging = true;
            dragOffsetX = mx - panelX;
            dragOffsetY = my - panelY;
            return true;
        }

        if (layout == Layout.Thunder) {
            return clickThunder(mx, my, button);
