import static org.lwjgl.glfw.GLFW.GLFW_MOUSE_BUTTON_RIGHT;

public class WMeteorModule extends WPressable implements MeteorWidget {
    private final Module module;

    private double titleWidth;
    private double hoverAnimation;
    private double activeAnimation;

    public WMeteorModule(Module module) {
        this.module = module;
        tooltip = module.description;

        hoverAnimation = module.isActive() ? 1 : 0;
        activeAnimation = module.isActive() ? 1 : 0;
    }

    @Override
    public double pad() {
        MeteorGuiTheme theme = theme();

        if (isMorzh(theme)) {
            return theme.scale(5);
        }

        return theme.scale(4);
    }

    @Override
    protected void onCalculateSize() {
        double pad = pad();

        if (titleWidth == 0) {
            titleWidth = theme.textWidth(module.title);
        }

        width = pad + titleWidth + pad;

        if (isMorzh(theme())) {
            width += theme.scale(8);
            height = pad + theme.textHeight() + pad;
        } else {
            height = pad + theme.textHeight() + pad;
        }
    }

    @Override
    protected void onPressed(int button) {
        if (button == GLFW_MOUSE_BUTTON_LEFT) {
            module.toggle();
        } else if (button == GLFW_MOUSE_BUTTON_RIGHT) {
            mc.setScreen(theme.moduleScreen(module));
        }
    }

    @Override
    protected void onRender(
        GuiRenderer renderer,
        double mouseX,
        double mouseY,
        double delta
    ) {
        MeteorGuiTheme theme = theme();

        if (isMorzh(theme)) {
            renderMorzh(renderer, theme, delta);
        } else {
            renderMeteor(renderer, theme, delta);
        }
    }

    private void renderMeteor(
        GuiRenderer renderer,
        MeteorGuiTheme theme,
        double delta
    ) {
        double pad = pad();

        hoverAnimation += delta * 4
            * ((module.isActive() || mouseOver) ? 1 : -1);

        hoverAnimation = MathHelper.clamp(
            hoverAnimation,
            0,
            1
        );

        activeAnimation += delta * 6
            * (module.isActive() ? 1 : -1);

        activeAnimation = MathHelper.clamp(
            activeAnimation,
            0,
            1
        );

        if (hoverAnimation > 0) {
            renderer.quad(
                x,
                y,
                width * hoverAnimation,
                height,
                theme.moduleBackground.get()
            );
        }

        if (activeAnimation > 0) {
            renderer.quad(
                x,
                y + height * (1 - activeAnimation),
                theme.scale(2),
                height * activeAnimation,
                theme.accentColor.get()
            );
        }

        double textX = this.x + pad;
        double availableWidth = width - pad * 2;

        if (theme.moduleAlignment.get() == AlignmentX.Center) {
            textX += availableWidth / 2 - titleWidth / 2;
        } else if (theme.moduleAlignment.get() == AlignmentX.Right) {
            textX += availableWidth - titleWidth;
        }

        renderer.text(
            module.title,
            textX,
            y + pad,
            theme.textColor.get(),
            false
        );
    }

    private void renderMorzh(
        GuiRenderer renderer,
        MeteorGuiTheme theme,
        double delta
    ) {
        double pad = pad();
        double border = theme.scale(1);
        double accentWidth = theme.scale(3);

        hoverAnimation += delta * 8
            * ((mouseOver || module.isActive()) ? 1 : -1);

        hoverAnimation = MathHelper.clamp(
            hoverAnimation,
            0,
            1
        );

        activeAnimation += delta * 10
            * (module.isActive() ? 1 : -1);

        activeAnimation = MathHelper.clamp(
            activeAnimation,
            0,
            1
        );

        renderer.quad(
            x,
            y,
            width,
            height,
            theme.backgroundColor.get(pressed, mouseOver)
        );

        if (hoverAnimation > 0) {
            renderer.quad(
                x,
                y,
                width * hoverAnimation,
                height,
                theme.moduleBackground.get()
            );
        }

        renderer.quad(
            x,
            y,
            width,
            border,
            theme.outlineColor.get(false, mouseOver)
        );

        renderer.quad(
            x,
            y + height - border,
            width,
            border,
            theme.outlineColor.get(false, mouseOver)
        );

        if (activeAnimation > 0) {
            renderer.quad(
                x,
                y + height * (1 - activeAnimation),
                accentWidth,
                height * activeAnimation,
                theme.accentColor.get()
            );
        }

        double textX = x + pad + accentWidth;

        if (mouseOver) {
            textX += theme.scale(2) * hoverAnimation;
        }

        renderer.text(
            module.title,
            textX,
            y + height / 2 - theme.textHeight() / 2,
            module.isActive()
                ? theme.titleTextColor.get()
                : theme.textColor.get(),
            false
        );

        if (module.isActive()) {
            double indicatorSize = theme.scale(4);

            renderer.quad(
                x + width - pad - indicatorSize,
                y + height / 2 - indicatorSize / 2,
                indicatorSize,
                indicatorSize,
                GuiRenderer.CIRCLE,
                theme.accentColor.get()
            );
        }
    }

    private boolean isMorzh(MeteorGuiTheme theme) {
        return "Morzh".equals(theme.name);
    }
}


