java

/*
 * Morzh Client sound manager.
 *
 * Sound assets originate from the studied ThunderHack and Rockstar clients.
 * Their attribution must be preserved in THIRD_PARTY_NOTICES.md.
 */

package meteordevelopment.meteorclient.utils.sound;

import net.minecraft.client.MinecraftClient;
import net.minecraft.client.sound.PositionedSoundInstance;
import net.minecraft.sound.SoundEvent;
import net.minecraft.util.Identifier;

public final class MorzhSoundManager {
    private static final String NAMESPACE = "morzh-client";

    private static final SoundEvent GUI_OPEN = event("gui.open");
    private static final SoundEvent GUI_CLOSE = event("gui.close");
    private static final SoundEvent GUI_BOOLEAN = event("gui.boolean");
    private static final SoundEvent GUI_SCROLL = event("gui.scroll");
    private static final SoundEvent GUI_KEYPRESS = event("gui.keypress");
    private static final SoundEvent GUI_KEYRELEASE = event("gui.keyrelease");

    private static final SoundEvent MODULE_ENABLE = event("module.enable");
    private static final SoundEvent MODULE_DISABLE = event("module.disable");

    private static final SoundEvent COMBAT_METALLIC =
        event("combat.metallic");

    private static final SoundEvent COMBAT_SKEET =
        event("combat.skeet");

    private static final SoundEvent COMBAT_CRIT =
        event("combat.crit");

    private static final SoundEvent COMBAT_BONK =
        event("combat.bonk");

    private static long lastScrollSound;

    private MorzhSoundManager() {
    }

    private static SoundEvent event(String path) {
        return SoundEvent.of(Identifier.of(NAMESPACE, path));
    }

    private static void play(SoundEvent event, float pitch) {
        MinecraftClient client = MinecraftClient.getInstance();

        if (client == null || client.getSoundManager() == null) return;

        client.getSoundManager().play(
            PositionedSoundInstance.master(event, pitch)
        );
    }

    public static void playOpen() {
        play(GUI_OPEN, 1.0f);
    }

    public static void playClose() {
        play(GUI_CLOSE, 1.0f);
    }

    public static void playBoolean() {
        play(GUI_BOOLEAN, 1.0f);
    }

    public static void playScroll() {
        long now = System.currentTimeMillis();

        if (now - lastScrollSound < 50) return;

        lastScrollSound = now;
        play(GUI_SCROLL, 1.0f);
    }

    public static void playKeyPress() {
        play(GUI_KEYPRESS, 1.0f);
    }

    public static void playKeyRelease() {
        play(GUI_KEYRELEASE, 1.0f);
    }

    public static void playModuleEnable() {
        play(MODULE_ENABLE, 1.0f);
    }

    public static void playModuleDisable() {
        play(MODULE_DISABLE, 1.0f);
    }

    public static void playModuleState(boolean enabled) {
        if (enabled) playModuleEnable();
        else playModuleDisable();
    }

    public static void playMetallic() {
        play(COMBAT_METALLIC, 1.0f);
    }

    public static void playSkeet() {
        play(COMBAT_SKEET, 1.0f);
    }

    public static void playCrit() {
        play(COMBAT_CRIT, 1.0f);
    }

    public static void playBonk() {
        play(COMBAT_BONK, 1.0f);
    }
}


