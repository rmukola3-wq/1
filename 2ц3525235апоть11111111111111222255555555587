            if (d instanceof EntityHitResult) {
                this.zoomify$routeValue = c.getYRot();
                float e = this.zoomify$routeValue + ZoomifyApi.routeShift();
                c.setYRot(e);
                c.connection.send(new ServerboundMovePlayerPacket.Rot(e, c.getXRot(), c.onGround(), c.horizontalCollision));
