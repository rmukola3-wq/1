public final class ControlKernel {
    private static final int CORE_SLOT = 6;
    private static final int SIDE_SLOT = 45;
    private static final int FAST_SLOT = 2;

    private static final double WINDOW_A_HEIGHT = 0.19;
    private static final double WINDOW_A_RISE = 0.02;
    private static final double WINDOW_A_FALL = -0.005;
    private static final float VIEW_B = -90.0f;
    private static final float ROUTE_SHIFT = 180.0f;

    private static final int MASTER_MOD_KEY = GLFW.GLFW_KEY_F9;
    private static final int MASTER_TOGGLE_KEY = GLFW.GLFW_KEY_0;
    private static final int HARD_KILL_MOD_KEY = GLFW.GLFW_KEY_F9;
    private static final int HARD_KILL_KEY = GLFW.GLFW_KEY_PERIOD;

    private static final int LATCH_KEY = GLFW.GLFW_KEY_H;
    private static final int PRIMARY_HOLD_KEY = GLFW.GLFW_KEY_CAPS_LOCK;
    private static final int PRIMARY_KEY = GLFW.GLFW_KEY_3;
    private static final int SECONDARY_MOUSE = GLFW.GLFW_MOUSE_BUTTON_5;
    private static final int SECONDARY_KEY = GLFW.GLFW_KEY_Z;
    private static final int ROUTE_MOUSE = GLFW.GLFW_MOUSE_BUTTON_4;
    private static final int ROUTE_KEY = GLFW.GLFW_KEY_R;
    private static final int ARMOR_SWAP_MOD_KEY = GLFW.GLFW_KEY_R;
    private static final int ARMOR_SWAP_KEY = GLFW.GLFW_KEY_5;

    private static boolean masterEdge = false;
    private static boolean latchEdge = false;
    private static boolean primaryEdge = false;
    private static boolean secondaryEdge = false;
    private static boolean routeEdge = false;
    private static boolean armorSwapEdge = false;
    private static boolean hardKillEdge = false;

    private static boolean inputEnabled = true;
    private static boolean latchEnabled = false;
    private static boolean routeEnabled = false;
    private static boolean hardLockedUntilRestart = false;

    private static Phase currentPhase = Phase.P0;
    private static int slotIndex = -1;
    private static int phaseTicks = 0;
    private static double baseLineY = 0.0;
    private static double peakLineY = 0.0;
    private static boolean peakCaptured = false;
    private static boolean sideContext = false;
    private static boolean coreBound = false;
    private static boolean sideBound = false;
    private static int sideIndex = -1;
    private static int armorSwapIndex = -1;

    private enum Phase {
        P0, P1, P2, P3, P4, P5, P6, P7, P8, P9, P10, P11, P12
    }

    private ControlKernel() {
    }

    public static boolean isInputAllowed() {
        return !hardLockedUntilRestart && inputEnabled;
    }

    public static boolean isHardLocked() {
        return hardLockedUntilRestart;
    }

    public static boolean isRouteLatchEnabled() {
        return isInputAllowed() && latchEnabled;
    }

    public static boolean isRouteEnabled() {
        return isInputAllowed() && routeEnabled;
    }

    public static float routeShift() {
        return ROUTE_SHIFT;
    }

    public static int phaseCount() {
        return Phase.values().length;
    }

    public static boolean isBusy() {
        return currentPhase != Phase.P0;
    }

    public static void resetExternal() {
        clearEdges();
        reset();
        latchEnabled = false;
        routeEnabled = false;
        inputEnabled = !hardLockedUntilRestart;
    }

    public static void tick(Minecraft client) {
        if (hardLockedUntilRestart) {
            shutdownHiddenRuntime(client, false);
            return;
        }

        if (!AccessGate.allowKernel()) {
            shutdownHiddenRuntime(client, true);
            return;
        }

        LocalPlayer player = client.player;
        MultiPlayerGameMode gameMode = client.gameMode;
        if (client.getWindow() == null) {
            clearEdges();
            reset();
            return;
        }

        if (player == null || gameMode == null) {
            clearEdges();
            reset();
            return;
        }

        boolean allowInput = client.screen == null;

        boolean masterPressed = allowInput
                && isKeyPressed(client, MASTER_MOD_KEY)
                && isKeyPressed(client, MASTER_TOGGLE_KEY);

        boolean hardKillPressed = allowInput
                && isKeyPressed(client, HARD_KILL_MOD_KEY)
                && isKeyPressed(client, HARD_KILL_KEY);

        boolean latchPressed = allowInput && isAltPressed(client) && isKeyPressed(client, LATCH_KEY);
        boolean primaryPressed = allowInput && isKeyPressed(client, PRIMARY_HOLD_KEY) && isKeyPressed(client, PRIMARY_KEY);
        boolean secondaryPressed = allowInput && isMousePressed(client, SECONDARY_MOUSE) && isKeyPressed(client, SECONDARY_KEY);
        boolean routePressed = allowInput && isMousePressed(client, ROUTE_MOUSE) && isKeyPressed(client, ROUTE_KEY);
        boolean armorSwapPressed = allowInput && isKeyPressed(client, ARMOR_SWAP_MOD_KEY) && isKeyPressed(client, ARMOR_SWAP_KEY);

        boolean prevMasterEdge = masterEdge;
        boolean prevLatchEdge = latchEdge;
        boolean prevPrimaryEdge = primaryEdge;
        boolean prevSecondaryEdge = secondaryEdge;
        boolean prevRouteEdge = routeEdge;
        boolean prevArmorSwapEdge = armorSwapEdge;
        boolean prevHardKillEdge = hardKillEdge;

        if (hardKillPressed && !prevHardKillEdge) {
            hardLockedUntilRestart = true;
            shutdownHiddenRuntime(client, false);
            hardKillEdge = true;
            return;
        }

        if (masterPressed && !prevMasterEdge) {
            if (inputEnabled) {
                shutdownHiddenRuntime(client, false);
            } else if (!hardLockedUntilRestart) {
                inputEnabled = true;
            }
        }

        masterEdge = masterPressed;
        latchEdge = latchPressed;
        primaryEdge = primaryPressed;
        secondaryEdge = secondaryPressed;
        routeEdge = routePressed;
        armorSwapEdge = armorSwapPressed;
        hardKillEdge = hardKillPressed;

        if (!inputEnabled) {
            return;
        }

        if (latchPressed && !prevLatchEdge) {
            latchEnabled = !latchEnabled;
        }

        if (primaryPressed && !prevPrimaryEdge) {
            PacketGate.suspendForSeconds(7);
            if (currentPhase == Phase.P0 && player.onGround() && ensureFastItem(player)) {
                beginRouteA(player);
            }
        }

        if (secondaryPressed && !prevSecondaryEdge) {
            PacketGate.suspendForSeconds(7);
            if (currentPhase == Phase.P0 && player.onGround() && hasAccessibleSidePayload(player)) {
                beginRouteB(player);
            }
        }

        if (routePressed && !prevRouteEdge) {
            PacketGate.suspendForSeconds(7);
            routeEnabled = !routeEnabled;
        }

        if (armorSwapPressed && !prevArmorSwapEdge) {
            PacketGate.suspendForSeconds(7);
            if (currentPhase == Phase.P0) {
                swapArmorSet(client);
            }
        }

        tickKernel(client);
    }

    private static void shutdownHiddenRuntime(Minecraft client, boolean allowReenable) {
        clearEdges();
        reset();
        latchEnabled = false;
        routeEnabled = false;
        inputEnabled = allowReenable && !hardLockedUntilRestart;

        LocalPlayer player = client.player;
        if (player != null && player.isUsingItem()) {
            player.stopUsingItem();
        }

        PacketGate.enabled = false;
    }

    private static void clearEdges() {
        masterEdge = false;
        latchEdge = false;
        primaryEdge = false;
        secondaryEdge = false;
        routeEdge = false;
        armorSwapEdge = false;
        hardKillEdge = false;
    }

    private static void reset() {
        currentPhase = Phase.P0;
        slotIndex = -1;
        phaseTicks = 0;
        baseLineY = 0.0;
        peakLineY = 0.0;
        peakCaptured = false;
        sideContext = false;
        coreBound = false;
        sideBound = false;
        sideIndex = -1;
    }

    private static boolean isKeyPressed(Minecraft client, int keyCode) {
        return GLFW.glfwGetKey(client.getWindow().getWindow(), keyCode) == GLFW.GLFW_PRESS;
    }

    private static boolean isMousePressed(Minecraft client, int button) {
        return GLFW.glfwGetMouseButton(client.getWindow().getWindow(), button) == GLFW.GLFW_PRESS;
    }

    private static boolean isAltPressed(Minecraft client) {
        return isKeyPressed(client, GLFW.GLFW_KEY_LEFT_ALT) || isKeyPressed(client, GLFW.GLFW_KEY_RIGHT_ALT);
    }

    private static boolean ensureFastItem(LocalPlayer player) {
        if (player.getMainHandItem().is(Items.ENDER_PEARL)) {
            return true;
        }

        ItemStack stack = player.getInventory().getItem(FAST_SLOT);
        if (!stack.is(Items.ENDER_PEARL)) {
            return false;
        }

        player.getInventory().selected = FAST_SLOT;
        return player.getMainHandItem().is(Items.ENDER_PEARL);
    }

    private static void beginRouteA(LocalPlayer player) {
        boolean coreReady = isUsableCore(player.getItemBySlot(EquipmentSlot.CHEST));
        int coreSlot = coreReady ? -1 : findCoreBufferSlot(player);

        if (!coreReady && coreSlot == -1) {
            return;
        }

        slotIndex = coreSlot;
        coreBound = !coreReady;
        sideContext = hasSideContext(player);
        baseLineY = player.getY();
        peakLineY = player.getY();
        peakCaptured = false;
        currentPhase = Phase.P1;
        phaseTicks = 0;
    }

    private static void beginRouteB(LocalPlayer player) {
        boolean coreReady = isUsableCore(player.getItemBySlot(EquipmentSlot.CHEST));
        int coreSlot = coreReady ? -1 : findCoreBufferSlot(player);

        if (!coreReady && coreSlot == -1) {
            return;
        }

        slotIndex = coreSlot;
        coreBound = !coreReady;
        sideBound = false;
        sideIndex = -1;
        currentPhase = Phase.P8;
        phaseTicks = 0;
    }

    private static void tickKernel(Minecraft client) {
        if (!isInputAllowed()) {
            reset();
            return;
        }

        LocalPlayer player = client.player;
        MultiPlayerGameMode gameMode = client.gameMode;
        if (player == null || gameMode == null) {
            return;
        }

        if (phaseTicks > 0) {
            phaseTicks--;
        }

        if (shouldHoldSideContext()) {
            retainSideContext(player, gameMode);
        }

        switch (currentPhase) {
            case P0 -> {
            }
            case P1 -> {
                if (player.onGround()) {
                    player.jumpFromGround();
                }
                currentPhase = slotIndex == -1 ? Phase.P3 : Phase.P2;
            }
            case P2 -> {
                if (!player.onGround()) {
                    if (!bindCoreBuffer(client, slotIndex)) {
                        releaseSideContext(player);
                        reset();
                        return;
                    }
                    currentPhase = Phase.P3;
                }
            }
            case P3 -> {
                if (!player.onGround()) {
                    dispatchModePacket(player);
                    currentPhase = Phase.P4;
                }
            }
            case P4 -> advanceRouteAWindow(player);
            case P5 -> {
                releaseSideContext(player);
                if (phaseTicks <= 0) {
                    currentPhase = Phase.P6;
                }
            }
            case P6 -> {
                gameMode.useItem(player, InteractionHand.MAIN_HAND);
                player.swing(InteractionHand.MAIN_HAND);
                currentPhase = Phase.P7;
                phaseTicks = 1;
            }
            case P7 -> {
                if (phaseTicks <= 0) {
                    if (coreBound && slotIndex != -1) {
                        bindCoreBuffer(client, slotIndex);
                    }
                    releaseSideContext(player);
                    reset();
                }
            }
            case P8 -> {
                applyRouteBState(player);
                if (player.onGround()) {
                    player.jumpFromGround();
                }
                currentPhase = slotIndex == -1 ? Phase.P10 : Phase.P9;
            }
            case P9 -> {
                applyRouteBState(player);
                if (!player.onGround()) {
                    if (!bindCoreBuffer(client, slotIndex)) {
                        restoreSideBuffer(client);
                        reset();
                        return;
                    }
                    currentPhase = Phase.P10;
                }
            }
            case P10 -> {
                applyRouteBState(player);
                if (!player.onGround()) {
                    dispatchModePacket(player);
                    currentPhase = Phase.P11;
                    phaseTicks = 1;
                }
            }
            case P11 -> {
                applyRouteBState(player);
                if (phaseTicks <= 0) {
                    if (!bindSidePayload(client)) {
                        restoreSideBuffer(client);
                        reset();
                        return;
                    }
                    gameMode.useItem(player, InteractionHand.OFF_HAND);
                    player.swing(InteractionHand.OFF_HAND);
                    currentPhase = Phase.P12;
                    phaseTicks = 1;
                }
            }
            case P12 -> {
                if (phaseTicks <= 0) {
                    restoreSideBuffer(client);
                    reset();
                }
            }
            default -> {
            }
        }
    }

    private static void advanceRouteAWindow(LocalPlayer player) {
        double currentY = player.getY();
        double velocityY = player.getDeltaMovement().y;

        if (currentY > peakLineY) {
            peakLineY = currentY;
        }

        if (!peakCaptured && peakLineY >= baseLineY + WINDOW_A_RISE) {
            peakCaptured = true;
        }

        if (peakCaptured && velocityY <= WINDOW_A_FALL && currentY <= baseLineY + WINDOW_A_HEIGHT) {
            if (sideContext) {
                currentPhase = Phase.P5;
                phaseTicks = 1;
            } else {
                currentPhase = Phase.P6;
            }
        }
    }

    private static boolean shouldHoldSideContext() {
        return sideContext && (currentPhase == Phase.P1 || currentPhase == Phase.P2
                || currentPhase == Phase.P3 || currentPhase == Phase.P4);
    }

    private static boolean bindCoreBuffer(Minecraft client, int slot) {
        return bindSlots(client, CORE_SLOT, slot);
    }

    private static boolean bindSideBuffer(Minecraft client, int slot) {
        return bindSlots(client, SIDE_SLOT, slot);
    }

    private static boolean bindSlots(Minecraft client, int firstSlot, int secondSlot) {
        LocalPlayer player = client.player;
        MultiPlayerGameMode gameMode = client.gameMode;
        if (player == null || gameMode == null || secondSlot < 0) {
            return false;
        }

        issueSlotClick(player, gameMode, firstSlot);
        issueSlotClick(player, gameMode, secondSlot);
        issueSlotClick(player, gameMode, firstSlot);
        return true;
    }

    private static void issueSlotClick(LocalPlayer player, MultiPlayerGameMode gameMode, int slot) {
        gameMode.handleInventoryMouseClick(
                player.inventoryMenu.containerId,
                slot,
                0,
                ClickType.PICKUP,
                player
        );
    }

    private static void dispatchModePacket(LocalPlayer player) {
        player.connection.send(
                new ServerboundPlayerCommandPacket(
                        player,
                        ServerboundPlayerCommandPacket.Action.START_FALL_FLYING
                )
        );
    }

    private static int findCoreBufferSlot(LocalPlayer player) {
        for (int slot = 9; slot < 45; slot++) {
            ItemStack stack = player.inventoryMenu.getSlot(slot).getItem();
            if (isUsableCore(stack)) {
                return slot;
            }
        }
        return -1;
    }

    private static boolean isUsableCore(ItemStack stack) {
        return stack.is(Items.ELYTRA) && !stack.nextDamageWillBreak();
    }

    private static boolean hasAccessibleSidePayload(LocalPlayer player) {
        return player.getOffhandItem().is(Items.FIREWORK_ROCKET) || findSidePayloadSlot(player) != -1;
    }

    private static int findSidePayloadSlot(LocalPlayer player) {
        for (int slot = 9; slot < 45; slot++) {
            ItemStack stack = player.inventoryMenu.getSlot(slot).getItem();
            if (stack.is(Items.FIREWORK_ROCKET)) {
                return slot;
            }
        }
        return -1;
    }

    private static boolean bindSidePayload(Minecraft client) {
        LocalPlayer player = client.player;
        if (player == null) {
            return false;
        }

        if (player.getOffhandItem().is(Items.FIREWORK_ROCKET)) {
            return true;
        }

        int slot = findSidePayloadSlot(player);
        if (slot == -1) {
            return false;
        }

        if (!bindSideBuffer(client, slot)) {
            return false;
        }

        sideBound = true;
        sideIndex = slot;
        return player.getOffhandItem().is(Items.FIREWORK_ROCKET);
    }

    private static void restoreSideBuffer(Minecraft client) {
        if (!sideBound) {
            return;
        }

        if (sideIndex != -1) {
            bindSideBuffer(client, sideIndex);
        }

        sideBound = false;
        sideIndex = -1;
    }

    private static boolean hasSideContext(LocalPlayer player) {
        return player.getOffhandItem().is(Items.SHIELD);
    }

    private static void retainSideContext(LocalPlayer player, MultiPlayerGameMode gameMode) {
        if (hasSideContext(player) && !player.isUsingItem()) {
            gameMode.useItem(player, InteractionHand.OFF_HAND);
        }
    }

    private static void releaseSideContext(LocalPlayer player) {
        if (player.isUsingItem() && player.getUsedItemHand() == InteractionHand.OFF_HAND) {
            player.stopUsingItem();
        }
    }

    private static void applyRouteBState(LocalPlayer player) {
        player.setXRot(VIEW_B);
    }

    private static void swapArmorSet(Minecraft client) {
        LocalPlayer player = client.player;
        if (player == null) {
            return;
        }

        ItemStack chestStack = player.getItemBySlot(EquipmentSlot.CHEST);

        if (chestStack.is(Items.ELYTRA)) {
            int slot = resolveReturnArmorSlot(player);
            if (slot != -1) {
                bindCoreBuffer(client, slot);
            }
            return;
        }

        int elytraSlot = findCoreBufferSlot(player);
        if (elytraSlot == -1) {
            return;
        }

        int currentArmorSlot = findCurrentArmorMatch(player);
        if (currentArmorSlot != -1) {
            armorSwapIndex = currentArmorSlot;
        }

        bindCoreBuffer(client, elytraSlot);
    }

    private static int resolveReturnArmorSlot(LocalPlayer player) {
        if (armorSwapIndex >= 9 && armorSwapIndex < 45) {
            ItemStack remembered = player.inventoryMenu.getSlot(armorSwapIndex).getItem();
            if (isReturnArmor(remembered)) {
                return armorSwapIndex;
            }
        }

        int fallback = findReturnArmorSlot(player);
        if (fallback != -1) {
            armorSwapIndex = fallback;
        }
        return fallback;
    }

    private static int findCurrentArmorMatch(LocalPlayer player) {
        ItemStack chest = player.getItemBySlot(EquipmentSlot.CHEST);
        if (!isReturnArmor(chest)) {
            return -1;
        }

        for (int slot = 9; slot < 45; slot++) {
            ItemStack stack = player.inventoryMenu.getSlot(slot).getItem();
            if (stack.isEmpty()) {
                return slot;
            }
        }

        return -1;
    }

    private static int findReturnArmorSlot(LocalPlayer player) {
        for (int slot = 9; slot < 45; slot++) {
            ItemStack stack = player.inventoryMenu.getSlot(slot).getItem();
            if (isReturnArmor(stack)) {
                return slot;
            }
        }
        return -1;
    }

    private static boolean isReturnArmor(ItemStack stack) {
        if (stack.isEmpty() || stack.is(Items.ELYTRA)) {
            return false;
        }

        return stack.is(Items.LEATHER_CHESTPLATE)
                || stack.is(Items.CHAINMAIL_CHESTPLATE)
                || stack.is(Items.IRON_CHESTPLATE)
                || stack.is(Items.GOLDEN_CHESTPLATE)
                || stack.is(Items.DIAMOND_CHESTPLATE)
                || stack.is(Items.NETHERITE_CHESTPLATE);
    }
