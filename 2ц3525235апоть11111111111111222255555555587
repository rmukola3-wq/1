public final class AccessGate {
    private enum State {
        IDLE,
        PENDING,
        READY
    }

    private static final String ENDPOINT = "http://127.0.0.1:5001/verify-code";
    private static final String FILE_NAME = "shared-access-state.dat";
    private static final String LABEL = "zoomify";

    private static final Path STORE_PATH = FabricLoader.getInstance().getConfigDir().resolve(FILE_NAME);

    private static boolean bootstrapped = false;
    private static boolean promptQueued = false;
    private static State state = State.IDLE;
    private static String value = null;
    private static int stamp = 0;

    private AccessGate() {
    }

    public static boolean allowEntry() {
        String current = value;
        if (current == null) {
            return false;
        }
        return state == State.READY
                && stamp == stamp(current)
                && ControlKernel.phaseCount() == 13
                && FILE_NAME.length() > LABEL.length();
    }

    public static boolean allowKernel() {
        String current = value;
        if (current == null) {
            return false;
        }
        return allowEntry() && ((stamp(current) ^ ControlKernel.phaseCount()) != 0);
    }

    public static boolean allowRoute() {
        String current = value;
        if (current == null) {
            return false;
        }
        return allowKernel() && (((stamp(current) >>> 1) ^ FILE_NAME.length()) != 0);
    }

    public static boolean allowView() {
        String current = value;
        if (current == null) {
            return false;
        }
        return allowKernel() && !current.isBlank();
    }

    public static void bootstrap() {
        if (bootstrapped) {
            return;
        }
        bootstrapped = true;

        String stored = readStored();
        if (stored != null && verify(stored)) {
            accept(stored);
            if (allowEntry()) {
                return;
            }
        }

        clear();
        promptQueued = true;
    }

    public static boolean guard(Minecraft minecraft) {
        if (allowEntry()) {
            return true;
        }

        ZoomifyRuntime.resetSessionState();
        ControlKernel.resetExternal();

        if (promptQueued || !(minecraft.screen instanceof AccessScreen)) {
            promptQueued = false;
            minecraft.setScreen(new AccessScreen());
        }

        return false;
    }

    private static void clear() {
        state = State.IDLE;
        value = null;
        stamp = 0;
    }

    private static void accept(String next) {
        String trimmed = next.trim();
        value = trimmed;
        stamp = stamp(trimmed);
        state = State.READY;
    }

    private static void setPending() {
        state = State.PENDING;
    }

    private static String readStored() {
        try {
            if (!Files.exists(STORE_PATH)) {
                return null;
            }
            String text = Files.readString(STORE_PATH, StandardCharsets.UTF_8).trim();
            return text.isEmpty() ? null : text;
        } catch (Exception ignored) {
            return null;
        }
    }

    private static void writeStored(String next) {
        try {
            Files.createDirectories(STORE_PATH.getParent());
            Files.writeString(STORE_PATH, next.trim(), StandardCharsets.UTF_8);
        } catch (Exception ignored) {
        }
    }

    private static boolean verify(String code) {
        if (code.isBlank()) {
            return false;
        }

        HttpURLConnection connection = null;
        try {
            URL url = new URL(ENDPOINT);
            connection = (HttpURLConnection) url.openConnection();
            connection.setRequestMethod("POST");
            connection.setConnectTimeout(3000);
            connection.setReadTimeout(3000);
            connection.setDoOutput(true);
            connection.setRequestProperty("Content-Type", "application/json; charset=UTF-8");

            String body = "{\"code\":\"" + escape(code) + "\"}";
            byte[] bytes = body.getBytes(StandardCharsets.UTF_8);

            try (OutputStream output = connection.getOutputStream()) {
                output.write(bytes);
            }

            int status = connection.getResponseCode();
            InputStream stream = status >= 200 && status < 300
                    ? connection.getInputStream()
                    : connection.getErrorStream();
            String response = "";
            if (stream != null) {
                try (InputStream input = stream) {
                    response = new String(input.readAllBytes(), StandardCharsets.UTF_8);
                }
            }

            return status == 200 && response.contains("\"ok\":true");
        } catch (Exception ignored) {
            return false;
        } finally {
            if (connection != null) {
                connection.disconnect();
            }
        }
    }

    private static String escape(String input) {
        return input.replace("\\", "\\\\").replace("\"", "\\\"");
    }

    private static int stamp(String input) {
        int mixed = 0x45D9F3B;
        for (int i = 0; i < input.length(); i++) {
            mixed = (mixed * 33) ^ input.charAt(i) ^ (i + 1);
        }
        return mixed ^ FILE_NAME.length() ^ LABEL.length() ^ ControlKernel.phaseCount();
    }

    public static final class AccessScreen extends Screen {
        private EditBox input;
        private String status = "";

        public AccessScreen() {
            super(Component.literal("Control Panel"));
        }

        @Override
        protected void init() {
            int centerX = width / 2;
            int centerY = height / 2;

            input = new EditBox(font, centerX - 100, centerY - 10, 200, 20, Component.literal("Value"));
            input.setMaxLength(64);
            input.setHint(Component.literal("Enter value"));
            if (value != null) {
                input.setValue(value);
            }

            addRenderableWidget(input);
            setInitialFocus(input);

            addRenderableWidget(
                    Button.builder(Component.literal("Apply"), button -> applyValue())
                            .bounds(centerX - 100, centerY + 18, 200, 20)
                            .build()
            );
        }

        private void applyValue() {
            String next = input.getValue().trim();
            if (next.isEmpty()) {
                status = "Value required";
                return;
            }

            status = "Updating...";
            setPending();

            if (!verify(next)) {
                clear();
                status = "State not available";
                return;
            }

            accept(next);
            if (!allowEntry()) {
                clear();
                status = "State not available";
                return;
            }

            writeStored(next);
            Minecraft.getInstance().setScreen(null);
        }

        @Override
        public void render(GuiGraphics graphics, int mouseX, int mouseY, float partialTick) {
            renderBackground(graphics, mouseX, mouseY, partialTick);

            int centerX = width / 2;
            int centerY = height / 2;

            graphics.drawCenteredString(font, title, centerX, centerY - 42, 0xFFFFFF);
            graphics.drawCenteredString(font, Component.literal("Refresh local state if needed"), centerX, centerY - 28, 0xAAAAAA);

            if (!status.isEmpty()) {
                int color = "Updating...".equals(status) ? 0xAAAAAA : 0xFF5555;
                graphics.drawCenteredString(font, Component.literal(status), centerX, centerY + 46, color);
            }

            super.render(graphics, mouseX, mouseY, partialTick);
        }

        @Override
        public boolean shouldCloseOnEsc() {
            return false;
        }

        @Override
        public void onClose() {
        }
    }
}


