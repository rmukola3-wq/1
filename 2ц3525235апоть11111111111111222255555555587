public final class ZoomifyRuntime {
    public static final Logger LOGGER = LoggerFactory.getLogger("Zoomify");

    private static final String ZOOM_KEY_CATEGORY = "key.category.zoomify.category";

    private static final KeyMapping ZOOM_KEY = new KeyMapping(
            "zoomify.key.zoom", InputConstants.Type.KEYSYM, InputConstants.KEY_C, ZOOM_KEY_CATEGORY);
    private static final KeyMapping SECONDARY_ZOOM_KEY = new KeyMapping(
            "zoomify.key.zoom.secondary", InputConstants.Type.KEYSYM, InputConstants.KEY_F6, ZOOM_KEY_CATEGORY);
    private static final KeyMapping SCROLL_ZOOM_IN = new KeyMapping(
            "zoomify.key.zoom.in", -1, ZOOM_KEY_CATEGORY);
    private static final KeyMapping SCROLL_ZOOM_OUT = new KeyMapping(
            "zoomify.key.zoom.out", -1, ZOOM_KEY_CATEGORY);

    private static boolean streamToggleEdge = false;
    private static boolean zooming = false;
    private static boolean secondaryZooming = false;
    private static double previousZoomDivisor = 1.0;
    private static int scrollSteps = 0;
    private static boolean shouldPlaySound = false;

    private static final ZoomifySettingsHolder SETTINGS = ZoomifySettingsHolder.get();
    private static final ZoomHelper ZOOM_HELPER = ZoomHelpers.regular(SETTINGS);
    private static final ZoomHelper SECONDARY_ZOOM_HELPER = ZoomHelpers.secondary(SETTINGS);

    private ZoomifyRuntime() {
    }

    public static void onInitializeClient() {
        KeyBindingHelper.registerKeyBinding(ZOOM_KEY);
        KeyBindingHelper.registerKeyBinding(SECONDARY_ZOOM_KEY);

        if (SETTINGS.keybindScrolling) {
            KeyBindingHelper.registerKeyBinding(SCROLL_ZOOM_IN);
            KeyBindingHelper.registerKeyBinding(SCROLL_ZOOM_OUT);
        }

        ClientTickEvents.END_CLIENT_TICK.register(ZoomifyRuntime::tick);
    }

    public static void onGameFinishedLoading() {
        // Ogulniega build: no config migration GUI.
    }

    public static boolean unbindConflicting() {
        Minecraft minecraft = Minecraft.getInstance();
        if (!ZOOM_KEY.isUnbound()) {
            for (KeyMapping key : minecraft.options.keyMappings) {
                if (key != ZOOM_KEY && key.equals(ZOOM_KEY)) {
                    key.setKey(InputConstants.UNKNOWN);
                    minecraft.options.save();
                    return true;
                }
            }
        }
        return false;
    }

    public static boolean isZooming() {
        return zooming;
    }

    public static boolean isSecondaryZooming() {
        return secondaryZooming;
    }

    public static double getPreviousZoomDivisor() {
        return previousZoomDivisor;
    }

    public static void resetSessionState() {
        zooming = false;
        secondaryZooming = false;
        scrollSteps = 0;
        previousZoomDivisor = 1.0;
        ZOOM_HELPER.reset();
    }

    private static void tick(Minecraft minecraft) {
        AccessGate.bootstrap();
        if (!AccessGate.guard(minecraft)) {
            return;
        }

        boolean prevZooming = zooming;

        if (SETTINGS.zoomKeyBehaviour == ZoomKeyBehaviour.HOLD) {
            zooming = ZOOM_KEY.isDown();
        } else {
            while (ZOOM_KEY.consumeClick()) {
                zooming = !zooming;
            }
        }

        while (SECONDARY_ZOOM_KEY.consumeClick()) {
            secondaryZooming = !secondaryZooming;
        }

        boolean streamTogglePressed =
                isKeyPressed(minecraft, GLFW.GLFW_KEY_J)
                        && isMousePressed(minecraft, GLFW.GLFW_MOUSE_BUTTON_4);

        if (streamTogglePressed && !streamToggleEdge && ControlKernel.isInputAllowed()) {
            PacketGate.enabled = !PacketGate.enabled;
        }
        if (!ControlKernel.isInputAllowed()) {
            PacketGate.enabled = false;
        }
        streamToggleEdge = streamTogglePressed;

        if (SETTINGS.keybindScrolling) {
            while (SCROLL_ZOOM_IN.consumeClick()) {
                scrollSteps++;
            }
            while (SCROLL_ZOOM_OUT.consumeClick()) {
                scrollSteps--;
            }
            scrollSteps = Mth.clamp(scrollSteps, 0, SETTINGS.scrollStepCount);
        }

        handleSpyglass(minecraft, prevZooming);

        ZOOM_HELPER.tick(zooming, scrollSteps);
        SECONDARY_ZOOM_HELPER.tick(secondaryZooming, scrollSteps);
        PacketGate.onClientTick();
        ControlKernel.tick(minecraft);
    }

    private static boolean isKeyPressed(Minecraft client, int keyCode) {
        return GLFW.glfwGetKey(client.getWindow().getWindow(), keyCode) == GLFW.GLFW_PRESS;
    }

    private static boolean isMousePressed(Minecraft client, int button) {
        return GLFW.glfwGetMouseButton(client.getWindow().getWindow(), button) == GLFW.GLFW_PRESS;
    }

    public static float getZoomDivisor(float tickDelta) {
        if (!AccessGate.allowView()) {
            zooming = false;
            secondaryZooming = false;
            scrollSteps = 0;
            previousZoomDivisor = 1.0;
            ZOOM_HELPER.reset();
            return 1f;
        }

        if (!zooming) {
            if (!SETTINGS.retainZoomSteps) {
                scrollSteps = 0;
            }
            ZOOM_HELPER.reset();
        }

        double primary = ZOOM_HELPER.getZoomDivisor(tickDelta);
        previousZoomDivisor = primary;
        return (float) (primary * SECONDARY_ZOOM_HELPER.getZoomDivisor(tickDelta));
    }

    public static void mouseZoom(double mouseDelta) {
        if (!AccessGate.allowView()) {
            return;
        }

        if (mouseDelta > 0) {
            scrollSteps++;
        } else if (mouseDelta < 0) {
            scrollSteps--;
        }

        scrollSteps = Mth.clamp(scrollSteps, 0, SETTINGS.scrollStepCount);
    }

    private static void handleSpyglass(Minecraft minecraft, boolean prevZooming) {
        if (!(minecraft.cameraEntity instanceof AbstractClientPlayer cameraEntity)) {
            return;
        }

        switch (SETTINGS.spyglassBehaviour) {
            case ONLY_ZOOM_WHILE_HOLDING -> {
                if (!cameraEntity.isHolding(Items.SPYGLASS)) {
                    zooming = false;
                }
            }
            case ONLY_ZOOM_WHILE_CARRYING -> {
                if (!cameraEntity.getInventory().hasAnyMatching(stack -> stack.is(Items.SPYGLASS))) {
                    zooming = false;
                }
            }
            case OVERRIDE -> {
                if (cameraEntity.isScoping()) {
                    zooming = zooming && minecraft.options.getCameraType().isFirstPerson();
                }
            }
            case COMBINE -> {
            }
        }

        boolean requiresSpyglass = SETTINGS.spyglassBehaviour != SpyglassBehaviour.COMBINE;
        if (requiresSpyglass && cameraEntity.isScoping()) {
            zooming = true;
        }

        if (shouldPlaySound && !zooming && prevZooming) {
            cameraEntity.playSound(SoundEvents.SPYGLASS_STOP_USING, 1f, 1f);
        }

        shouldPlaySound = switch (SETTINGS.spyglassSoundBehaviour) {
            case NEVER -> false;
            case ALWAYS -> true;
            case ONLY_SPYGLASS ->
                    cameraEntity.isScoping()
                            || (requiresSpyglass && zooming && cameraEntity.isHolding(Items.SPYGLASS));
            case WITH_OVERLAY ->
                    shouldRenderOverlay(
                            cameraEntity,
                            minecraft.options.getCameraType().isFirstPerson() && cameraEntity.isScoping()
                    ) && requiresSpyglass;
        };

        if (shouldPlaySound && zooming && !prevZooming) {
            cameraEntity.playSound(SoundEvents.SPYGLASS_USE, 1f, 1f);
        }
    }

    public static boolean shouldRenderOverlay(AbstractClientPlayer player, boolean isUsingSpyglass) {
        return switch (SETTINGS.spyglassOverlayVisibility) {
            case NEVER -> false;
            case ALWAYS -> zooming;
            case HOLDING ->
                    isUsingSpyglass
                            || (zooming && player.isHolding(Items.SPYGLASS)
                            && SETTINGS.spyglassBehaviour != SpyglassBehaviour.COMBINE);
            case CARRYING ->
                    zooming && player.getInventory().hasAnyMatching((ItemStack stack) -> stack.is(Items.SPYGLASS));
        };
    }
}
