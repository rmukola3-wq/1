import java.util.function.DoubleSupplier;

public class SmoothInterpolator implements Interpolator {
    private final DoubleSupplier smoothness;

    public SmoothInterpolator(DoubleSupplier smoothness) {
        this.smoothness = smoothness;
    }

    @Override
    public double tickInterpolation(double targetInterpolation, double currentInterpolation, double tickDelta) {
        if (!isSmooth()) {
            return targetInterpolation;
        }

        if (targetInterpolation > currentInterpolation) {
            double diff = targetInterpolation - currentInterpolation;
            double increment = diff * smoothness.getAsDouble() / 0.05 * tickDelta;
            return Math.min(currentInterpolation + increment, targetInterpolation);
        }
        if (targetInterpolation < currentInterpolation) {
            double diff = currentInterpolation - targetInterpolation;
            double increment = diff * smoothness.getAsDouble() / 0.05 * tickDelta;
            return Math.max(currentInterpolation - increment, targetInterpolation);
        }
        return targetInterpolation;
    }

    @Override
    public boolean isSmooth() {
        return smoothness.getAsDouble() != 1.0;
    }
}


