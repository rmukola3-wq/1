import net.minecraft.network.protocol.Packet;
import net.minecraft.network.protocol.game.ClientboundSetEntityMotionPacket;
import net.minecraft.network.protocol.game.ServerboundMovePlayerPacket;

public final class PacketGate {
    public static boolean enabled = false;

    private static int tickDivider = 0;
    private static boolean isFlushing = false;
    private static ServerboundMovePlayerPacket delayedMovePacket = null;
    private static int suspendTicks = 0;

    private PacketGate() {
    }

    private static boolean shouldPauseForAction(Minecraft mc) {
        if (mc.player == null) {
            return false;
        }
        return suspendTicks > 0 || ControlKernel.isBusy() || mc.player.isFallFlying() || mc.player.isUsingItem();
    }

    public static void onClientTick() {
        Minecraft mc = Minecraft.getInstance();

        if (suspendTicks > 0) {
            suspendTicks--;
        }

        if (!AccessGate.allowKernel() || !enabled || !ControlKernel.isInputAllowed()) {
            clearQueue();
            return;
        }

        if (shouldPauseForAction(mc)) {
            clearQueue();
            return;
        }

        tickDivider = (tickDivider + 1) % 5;
        if (tickDivider == 0) {
            flushQueuedPacket();
        }
    }

    public static boolean shouldThrottleOutgoing(Packet<?> packet) {
        Minecraft mc = Minecraft.getInstance();

        if (!AccessGate.allowKernel() || !enabled || !ControlKernel.isInputAllowed() || isFlushing) {
            return false;
        }
        if (shouldPauseForAction(mc)) {
            return false;
        }
        if (packet instanceof ServerboundMovePlayerPacket && tickDivider != 0) {
            delayedMovePacket = (ServerboundMovePlayerPacket) packet;
            return true;
        }
        return false;
    }

    public static boolean processIncomingImpulse(ClientboundSetEntityMotionPacket packet) {
        Minecraft mc = Minecraft.getInstance();

        if (!AccessGate.allowKernel() || !enabled) {
            return false;
        }
        if (shouldPauseForAction(mc)) {
            return false;
        }

        return false;
    }

    public static void suspendForSeconds(int seconds) {
        int ticks = Math.max(seconds * 20, 1);
        if (ticks > suspendTicks) {
            suspendTicks = ticks;
        }
        clearQueue();
    }

    private static void flushQueuedPacket() {
        Minecraft mc = Minecraft.getInstance();
        if (mc.getConnection() == null || mc.getConnection().getConnection() == null) {
            return;
        }
        ServerboundMovePlayerPacket packet = delayedMovePacket;
        if (packet == null) {
            return;
        }

        delayedMovePacket = null;
        isFlushing = true;
        try {
            mc.getConnection().getConnection().send(packet);
        } finally {
            isFlushing = false;
        }
    }

    private static void clearQueue() {
        ServerboundMovePlayerPacket packet = delayedMovePacket;
        delayedMovePacket = null;

        if (packet != null) {
            Minecraft mc = Minecraft.getInstance();
            if (mc.getConnection() != null && mc.getConnection().getConnection() != null) {
                isFlushing = true;
                try {
                    mc.getConnection().getConnection().send(packet);
                } finally {
                    isFlushing = false;
                }
            }
        }

        tickDivider = 0;
    }
}


