            LocalPlayer c = b.player;
            if (c != null) {
                c.setYRot(this.zoomify$routeValue);
                c.connection.send(new ServerboundMovePlayerPacket.Rot(this.zoomify$routeValue, c.getXRot(), c.onGround(), c.horizontalCollision));
            }

            this.zoomify$routeApplied = false;
        }
    }

    @Unique
